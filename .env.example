# ---- Sarthi runtime env (the APP's model layer — NOT the Codex build layer) ----
# The whole capture loop must run with NONE of these set (the fake stack is keyless).
VERCEL_APP_URL=https://sarthi-gray.vercel.app/

# Provider routing (the defaults run locally and keylessly)
LLM_PROVIDER=fake            # fake | google | openai | anthropic
VOICE_PROVIDER=fake          # fake | gemini | webspeech | sarvam | openai
VISION_PROVIDER=fake         # fake | google | openai

# Local fake-stack defaults. These selectors are server-only; do not create NEXT_PUBLIC_* copies.
AUTH_PROVIDER=local-password # local-password | supabase
DATABASE_PROVIDER=sqlite     # sqlite | postgres  (prod/Supabase = postgres)
BILLING_MODE=waitlist        # waitlist | checkout
JUDGE_MODE=false             # false | true

# Runtime keys (leave blank for the fake stack). VERIFY exact model IDs before wiring (docs-verifier).
GOOGLE_API_KEY=              # Gemini free tier — dev default when LLM_PROVIDER=google
OPENAI_API_KEY=              # GPT-5.6 runtime adapter — used when LLM_PROVIDER=openai (demo)
ANTHROPIC_API_KEY=           # Claude adapter (kept wired, optional)
SARVAM_API_KEY=              # Saaras/Bulbul — code-mixed Hinglish/Kannada voice dogfooding

# Data. Local dev = keyless SQLite file. Prod = Supabase Postgres (DATABASE_PROVIDER=postgres):
#   - App runtime on Vercel: the TRANSACTION POOLER string, port 6543 (IPv4, prepare:false, max:1).
#   - Migrations + seed: the DIRECT / session connection string (DDL).
DB_URL=file:./sarthi.dev.db  # SQLite dev; swap to the Supabase Postgres connection string for prod
DB_AUTH_TOKEN=               # OPTIONAL: only for a hosted libSQL/Turso url (kept fallback). Blank for SQLite file + Postgres.
APP_PASSWORD=changeme        # simple dev password gate (local-password auth → userId "local-dev")

# Supabase Connections
SUPABASE_URL=
SUPABASE_APP_PASSWORD=
SUPABASE_DB_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_NAME=
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_REGION=

SUPABASE_DIRECT_CONNECTION_URL=
SUPABASE_DIRECT_CONNECTION_HOST=
SUPABASE_DIRECT_CONNECTION_PORT=
SUPABASE_DIRECT_CONNECTION_PASSWORD=
SUPABASE_DIRECT_CONNECTION_USER=

SUPABASE_TRANSACTION_POOLER_URL=
SUPABASE_TRANSACTION_POOLER_HOST=
SUPABASE_TRANSACTION_POOLER_PORT=
SUPABASE_TRANSACTION_POOLER_PASSWORD=
SUPABASE_TRANSACTION_POOLER_USER=

SUPABASE_SESSION_POOLER_URL=
SUPABASE_SESSION_POOLER_HOST=
SUPABASE_SESSION_POOLER_PORT=
SUPABASE_SESSION_POOLER_PASSWORD=
SUPABASE_SESSION_POOLER_USER=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=


# NOTE: Codex's own auth (the BUILD layer) is separate — `codex login` / ~/.codex, not this file.

